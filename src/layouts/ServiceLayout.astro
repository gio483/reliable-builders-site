---
import BaseLayout from './BaseLayout.astro';
import Button from '../components/Button.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, services } from '../config/site';

export interface Props {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  headline: string;
  subhead: string;
  heroImage: string;
  priceRange: string;
  includes: { t: string; d: string }[];
  faqs: { q: string; a: string }[];
}
const {
  slug,
  metaTitle,
  metaDescription,
  eyebrow,
  headline,
  subhead,
  heroImage,
  priceRange,
  includes,
  faqs,
} = Astro.props;

const others = services.filter((s) => s.slug !== slug);
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-800">
    <div class="absolute inset-0">
      <img src={heroImage} alt={headline} class="h-full w-full object-cover opacity-40" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/75 to-navy-800/40"></div>
    </div>
    <div class="container-rb relative py-24 sm:py-28">
      <div class="max-w-2xl">
        <span class="eyebrow text-brass-300">{eyebrow}</span>
        <h1 class="mt-5 text-display-xl text-white">{headline}</h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">{subhead}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={`tel:${site.phoneRaw}`} variant="secondary" size="lg">Call or text {site.phone}</Button>
          <Button href="/contact" variant="white" size="lg">Get a free estimate</Button>
        </div>
        <p class="mt-6 text-sm text-white/70">
          Typical investment: <span class="font-semibold text-brass-300">{priceRange}</span>
          · {site.license} · Licensed & Insured
        </p>
      </div>
    </div>
  </section>

  <!-- Intro prose -->
  <section class="section">
    <div class="container-rb prose-rb max-w-prose-wide">
      <slot />
    </div>
  </section>

  <!-- What's included -->
  <section class="section bg-stone-warm">
    <div class="container-rb">
      <div class="max-w-2xl">
        <span class="eyebrow">What’s included</span>
        <h2 class="mt-4 text-display-md">Everything handled, nothing hidden.</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          includes.map((it) => (
            <div class="card p-6">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brass-100 text-brass-700">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10l4 4 8-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 class="mt-4 text-lg font-semibold text-ink">{it.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{it.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <!-- Lead form -->
  <section class="section bg-stone-warm">
    <div class="container-rb mx-auto max-w-prose-wide">
      <LeadForm />
    </div>
  </section>

  <!-- Cross-links -->
  <section class="section">
    <div class="container-rb">
      <h2 class="text-display-sm">Explore our other services</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          others.map((s) => (
            <a href={`/services/${s.slug}`} class="group card flex items-center gap-5 overflow-hidden p-4 transition-shadow hover:shadow-lift">
              <img src={s.image} alt={s.name} class="h-24 w-24 shrink-0 rounded-xl object-cover" loading="lazy" />
              <div>
                <h3 class="text-lg font-semibold text-ink group-hover:text-navy-600">{s.name}</h3>
                <p class="mt-1 text-sm text-ink/70">{s.tagline}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
