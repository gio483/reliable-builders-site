---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
---

<BaseLayout title="Thank You | Reliable Builders" description="Thanks for reaching out to Reliable Builders." noindex={true}>
  <section class="section">
    <div class="container-rb flex min-h-[50vh] flex-col items-center justify-center text-center">
      <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-navy-600 text-white">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <h1 class="mt-6 text-display-lg">Thanks — we’ve got it.</h1>
      <p class="mt-4 max-w-xl text-lg text-ink/75">
        We’ll get back to you within one business day. If you’d rather talk now, we’re happy to pick
        up the phone.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={`tel:${site.phoneRaw}`} variant="secondary" size="lg">Call or text {site.phone}</Button>
        <Button href="/" variant="ghost" size="lg">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
