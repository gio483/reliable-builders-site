---
import { nav, site } from '../config/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header
  class="sticky top-0 z-40 border-b border-ink/[0.06] bg-stone/90 backdrop-blur supports-[backdrop-filter]:bg-stone/75"
>
  <div class="container-rb flex h-[76px] items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="Reliable Builders home">
      <Logo class="h-12 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-navy-600'
                : 'text-ink/70 hover:text-navy-600',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneRaw}`}
        class="hidden items-center gap-2 rounded-full bg-navy-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy-700 sm:inline-flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
          ><path
            d="M2 4.5A2.5 2.5 0 0 1 4.5 2h1.6a1 1 0 0 1 .96.73l1 3.5a1 1 0 0 1-.5 1.15l-1.5.82a11 11 0 0 0 4.54 4.54l.82-1.5a1 1 0 0 1 1.15-.5l3.5 1a1 1 0 0 1 .73.96v1.6A2.5 2.5 0 0 1 15.5 18 13.5 13.5 0 0 1 2 4.5Z"
          ></path></svg
        >
        {site.phone}
      </a>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-navy-700 hover:bg-white lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path></svg
        >
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-ink/[0.06] bg-stone lg:hidden">
    <nav class="container-rb flex flex-col py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-ink/[0.05] py-3 text-base font-medium text-ink/80"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`tel:${site.phoneRaw}`}
        class="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-navy-600 px-5 py-3 text-sm font-semibold text-white"
      >
        Call {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
