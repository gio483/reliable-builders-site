---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import LeadForm from '../../components/LeadForm.astro';
import CTABand from '../../components/CTABand.astro';
import { site, services } from '../../config/site';

export async function getStaticPaths() {
  const locations = await getCollection('locations', ({ data }) => !data.draft);
  return locations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props;
const { Content } = await location.render();
const city = location.data.city;

// Nearby communities for the cross-link block.
const relatedLocations = (
  await Promise.all(location.data.relatedLocations.map((slug) => getEntry('locations', slug)))
).filter(Boolean);

// Extract simple FAQs from the body (### questions under a "## ...questions" heading)
// for FAQPage structured data.
const faqs: { q: string; a: string }[] = [];
{
  const lines = location.body.split('\n');
  let inFaq = false;
  let q: string | null = null;
  let a: string[] = [];
  const flush = () => {
    if (q && a.length) faqs.push({ q, a: a.join(' ').trim() });
    q = null;
    a = [];
  };
  for (const line of lines) {
    if (/^##\s/.test(line)) {
      flush();
      inFaq = /question/i.test(line);
      continue;
    }
    if (!inFaq) continue;
    if (/^###\s/.test(line)) {
      flush();
      q = line.replace(/^###\s+/, '').trim();
    } else if (q && line.trim()) {
      a.push(line.replace(/[*_`#>]/g, '').trim());
    }
  }
  flush();
}

const pageUrl = `${site.url}/serving/${location.slug}`;
const schema: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: `${site.url}/serving` },
      { '@type': 'ListItem', position: 3, name: city, item: pageUrl },
    ],
  },
];
if (faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout title={location.data.metaTitle} description={location.data.metaDescription}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-800">
    {
      location.data.heroImage && (
        <div class="absolute inset-0">
          <img src={location.data.heroImage} alt={`Remodeling in ${city}`} class="h-full w-full object-cover opacity-40" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/75 to-navy-800/40" />
        </div>
      )
    }
    <div class="container-rb relative py-20 sm:py-24">
      <div class="max-w-2xl">
        <span class="eyebrow text-brass-300">Areas we serve · San Diego</span>
        <h1 class="mt-5 text-display-xl text-white">Kitchen, Bath & ADU Remodeling in {city}</h1>
        {location.data.tagline && <p class="mt-6 max-w-xl text-lg text-white/85">{location.data.tagline}</p>}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={`tel:${site.phoneRaw}`} variant="secondary" size="lg">Call or text {site.phone}</Button>
          <Button href="/contact" variant="white" size="lg">Get a free estimate</Button>
        </div>
        <p class="mt-6 text-sm text-white/70">{site.license} · Licensed & Insured · Serving {city} and nearby</p>
      </div>
    </div>
  </section>

  <!-- Long-form local content -->
  <section class="section">
    <div class="container-rb prose-rb max-w-prose-wide">
      <Content />
    </div>
  </section>

  <!-- Lead form -->
  <section class="section bg-stone-warm">
    <div class="container-rb mx-auto max-w-prose-wide">
      <LeadForm heading={`Start your ${city} project`} />
    </div>
  </section>

  <!-- Service interlink -->
  <section class="section">
    <div class="container-rb">
      <span class="eyebrow">What we build in {city}</span>
      <h2 class="mt-4 text-display-md">Kitchens, bathrooms & ADUs</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          services.map((s) => (
            <a href={`/services/${s.slug}`} class="group card overflow-hidden transition-shadow hover:shadow-lift">
              <img src={s.image} alt={s.name} class="aspect-[4/3] w-full object-cover" loading="lazy" />
              <div class="p-6">
                <h3 class="text-lg font-semibold text-ink group-hover:text-navy-600">{s.name}</h3>
                <p class="mt-2 text-sm text-ink/70">{s.tagline}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Nearby communities -->
  {
    relatedLocations.length > 0 && (
      <section class="section bg-stone-warm">
        <div class="container-rb text-center">
          <span class="eyebrow">Nearby communities</span>
          <h2 class="mt-4 text-display-md">We also work in</h2>
          <div class="mx-auto mt-8 max-w-3xl text-lg leading-loose text-ink/80">
            {relatedLocations.map((loc, i) => (
              <>
                <a href={`/serving/${loc.slug}`} class="font-medium text-navy-600 hover:text-brass-600">
                  {loc.data.city}
                </a>
                {i < relatedLocations.length - 1 && <span class="text-ink/30"> · </span>}
              </>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand heading={`Planning a remodel in ${city}?`} />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</BaseLayout>
