---
import { nav, site, services } from '../config/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-navy-800 text-white/80">
  <div class="container-rb py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <Logo class="h-16 w-auto" variant="light" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">
          Honest, licensed remodeling in San Diego — kitchens, bathrooms, and ADUs, built to last
          and explained every step of the way.
        </p>
        <p class="mt-4 text-xs font-medium uppercase tracking-eyebrow text-brass-300">
          {site.license} · Licensed & Insured
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-eyebrow text-white">Services</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="text-white/70 hover:text-brass-300">
                  {s.name}
                </a>
              </li>
            ))
          }
          <li><a href="/services/garage-conversions" class="text-white/70 hover:text-brass-300">Garage Conversions</a></li>
          <li><a href="/services/whole-home-remodels" class="text-white/70 hover:text-brass-300">Whole-Home Remodels</a></li>
          <li><a href="/services/home-additions" class="text-white/70 hover:text-brass-300">Home Additions</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-eyebrow text-white">Company</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/about" class="text-white/70 hover:text-brass-300">About Reliable Builders</a></li>
          <li><a href="/serving" class="text-white/70 hover:text-brass-300">Areas We Serve</a></li>
          <li><a href="/blog" class="text-white/70 hover:text-brass-300">Remodeling Guides</a></li>
          <li><a href="/contact" class="text-white/70 hover:text-brass-300">Request an Estimate</a></li>
          <li><a href="/privacy" class="text-white/70 hover:text-brass-300">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-eyebrow text-white">Get in Touch</h4>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={`tel:${site.phoneRaw}`} class="font-semibold text-white hover:text-brass-300"
              >{site.phone}</a
            >
          </li>
          <li><a href={`mailto:${site.email}`} class="text-white/70 hover:text-brass-300">{site.email}</a></li>
          <li class="text-white/70">
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </li>
          <li class="text-white/60">{site.hours}</li>
        </ul>
      </div>
    </div>

    <!-- Outdoor / sister company -->
    <div
      class="mt-12 flex flex-col gap-4 rounded-2xl bg-white/[0.05] p-6 ring-1 ring-white/10 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-white/75">
        <span class="font-semibold text-white">Looking for outdoor work?</span>
        Backyards, patios, pavers, and outdoor living are handled by our sister company,
        <span class="text-white">San Diego Landscape Remodeling</span> — reach out to them for
        anything outside the home.
      </p>
      <a
        href="https://sandiegolandscaperemodeling.com"
        target="_blank"
        rel="noopener"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-brass-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brass-600"
      >
        Visit San Diego Landscape Remodeling
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"
          ><path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </a>
    </div>

    <div
      class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 text-xs text-white/50 sm:flex-row sm:items-center"
    >
      <p class="text-white/50">© {year} {site.legalName}. All rights reserved. {site.license}.</p>
      <p class="text-white/50">Serving San Diego County — kitchens, bathrooms & ADUs.</p>
    </div>
  </div>
</footer>
