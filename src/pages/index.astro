---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, services } from '../config/site';

const trust = [
  `${site.license}`,
  'Licensed & Insured',
  `${site.yearsExperience} Years' Experience`,
  'Kitchens · Baths · ADUs',
];

const values = [
  {
    title: 'We educate — we don’t pressure',
    body: 'No rep who won’t leave until you sign. We walk you through your options, explain the tradeoffs, and let you decide on your own time.',
    icon: 'book',
  },
  {
    title: 'Straight answers, even when they cost us',
    body: 'If a cheaper approach is right for your home, we’ll tell you — even if it means a smaller job for us. Honesty is how we earn the referral.',
    icon: 'shield',
  },
  {
    title: 'One team, start to finish',
    body: 'Michael runs every project personally, with tile and countertop done in-house. You always know who’s in your home and who to call.',
    icon: 'users',
  },
  {
    title: 'Built to look new in year ten',
    body: 'Proper waterproofing, real materials, code-correct work. We build so it still looks right long after the last crew has left.',
    icon: 'check',
  },
];

const steps = [
  { n: '01', t: 'A real conversation', d: 'We visit your home, listen to what you actually want, and give you honest ballpark numbers before you spend a dime.' },
  { n: '02', t: 'Design & plan', d: 'We bring in our trusted design partner for selections and drawings, then lock a clear scope, timeline, and fixed price.' },
  { n: '03', t: 'We build it', d: 'One accountable crew, clean job sites, and steady communication — you’re never left wondering what’s happening this week.' },
  { n: '04', t: 'Final walkthrough', d: 'We walk every detail together and don’t call it done until you’d happily send us to your neighbor.' },
];

const gallery = [
  { src: '/images/work-kitchen-1.jpg', alt: 'Modern white kitchen remodel in San Diego with island and quartz counters' },
  { src: '/images/work-bath-1.jpg', alt: 'Spa-style bathroom remodel with walk-in tile shower' },
  { src: '/images/work-adu-1.jpg', alt: 'Detached backyard ADU exterior in San Diego' },
  { src: '/images/work-kitchen-2.jpg', alt: 'Warm transitional kitchen with wood cabinetry' },
  { src: '/images/work-bath-2.jpg', alt: 'Contemporary bathroom vanity with brass fixtures' },
  { src: '/images/work-adu-2.jpg', alt: 'Bright ADU interior kitchenette and living space' },
];

const faqs = [
  { q: 'How much does a kitchen remodel cost in San Diego?', a: 'Most of our full kitchen remodels land between <strong>$30,000 and $60,000</strong>, depending on the size, cabinetry, and finishes. On our first visit we give you an honest range for your specific kitchen — not a lowball number that balloons later.' },
  { q: 'How long does a bathroom remodel take?', a: 'A typical bathroom runs <strong>one to three months</strong> from demo to finished, depending on how much we’re moving and how custom the tile work is. We give you a real timeline up front and keep you posted every week.' },
  { q: 'Do you build ADUs and garage conversions?', a: 'Yes. We build detached ADUs and garage conversions across San Diego — permitted, engineered, and built to code. They’re a great fit for aging parents, adult kids, or long-term rental income.' },
  { q: 'Are you licensed and insured?', a: `Yes — Reliable Builders is fully licensed and insured under <strong>${site.license}</strong>. We’re happy to send proof of insurance and our license details before any work begins.` },
  { q: 'What’s your smallest project?', a: 'We focus on remodels of about <strong>$15,000 and up</strong>. If your project is smaller than that, we’ll gladly point you toward someone reputable rather than overcharge you for it.' },
  { q: 'What areas do you serve?', a: 'We work throughout central and east San Diego County — San Carlos, Del Cerro, Allied Gardens, La Mesa, Mount Helix, Bonita, El Cajon, Santee, and nearby neighborhoods.' },
];

function icon(name: string) {
  const paths: Record<string, string> = {
    book: 'M4 5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v14l-6-3-6 3V5Z',
    shield: 'M10 2l7 3v5c0 5-3.5 7.5-7 8-3.5-.5-7-3-7-8V5l7-3Z',
    users: 'M7 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-11 9a5 5 0 0 1 10 0M13 17a5 5 0 0 1 5-5',
    check: 'M4 10l4 4 8-9',
  };
  return paths[name] ?? paths.check;
}
---

<BaseLayout
  title="San Diego Remodeling & ADU Builder | Kitchens, Baths & ADUs — Reliable Builders"
  description="Honest, licensed San Diego general contractor for kitchen remodels, bathroom remodels, and ADUs. Education-first, no hard sell. CSLB #1139785. Call (619) 666-7556."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-800">
    <div class="absolute inset-0">
      <img
        src="/images/hero-home.jpg"
        alt="Newly remodeled modern kitchen in a San Diego home"
        class="h-full w-full object-cover opacity-40"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/70 to-navy-800/40"></div>
    </div>

    <div class="container-rb relative py-24 sm:py-28 lg:py-36">
      <div class="max-w-2xl">
        <span class="eyebrow text-brass-300">San Diego · Licensed GC · {site.license}</span>
        <h1 class="mt-5 text-display-xl text-white">
          Remodels done right — and explained every step of the way.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">
          Kitchens, bathrooms, and ADUs built by a hands-on San Diego contractor who tells you the
          truth, respects your budget, and never pressures you into a thing.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={`tel:${site.phoneRaw}`} variant="secondary" size="lg">
            Call or text {site.phone}
          </Button>
          <Button href="/contact" variant="white" size="lg">Get a free estimate</Button>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
          {trust.map((t) => (
            <span class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-brass-400"></span>{t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-rb">
      <div class="max-w-2xl">
        <span class="eyebrow">What we build</span>
        <h2 class="mt-4 text-display-lg">Three things, done exceptionally well.</h2>
        <p class="mt-4 text-ink/70">
          We stay in our lane on purpose. Kitchens, bathrooms, and ADUs are what we do day in and
          day out — so you get a specialist, not a jack-of-all-trades.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          services.map((s) => (
            <a href={`/services/${s.slug}`} class="group card overflow-hidden transition-shadow hover:shadow-lift">
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={s.image}
                  alt={s.name}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-display-sm">{s.name}</h3>
                  <span class="rounded-full bg-brass-50 px-3 py-1 text-xs font-semibold text-brass-700">
                    {s.priceRange}
                  </span>
                </div>
                <p class="mt-3 text-ink/70">{s.blurb}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-600 group-hover:gap-2.5 transition-all">
                  Explore {s.short}
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-center text-ink/60">
        Also do whole-home remodels and new builds — Michael has 20 years across all of it.
        <a href="/contact" class="font-semibold text-navy-600 underline decoration-brass-300 underline-offset-2">Ask us about your project.</a>
      </p>
    </div>
  </section>

  <!-- Differentiator -->
  <section class="section bg-stone-warm">
    <div class="container-rb">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow">Why homeowners choose us</span>
        <h2 class="mt-4 text-display-lg">The opposite of the high-pressure remodel company.</h2>
        <p class="mt-4 text-ink/70">
          You’ve probably had the salesperson who won’t leave your kitchen until you sign. That’s
          not us. We’d rather earn your trust than corner you into a contract.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v) => (
            <div class="card p-6">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-navy-600 text-brass-300">
                <svg class="h-6 w-6" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path d={icon(v.icon)} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="mt-5 text-lg font-semibold text-ink">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container-rb">
      <div class="max-w-2xl">
        <span class="eyebrow">How it works</span>
        <h2 class="mt-4 text-display-lg">A calm, clear path from idea to finished.</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <div class="relative">
              <span class="font-display text-5xl font-bold text-brass-200">{s.n}</span>
              <h3 class="mt-3 text-lg font-semibold text-ink">{s.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent work -->
  <section class="section bg-stone-warm">
    <div class="container-rb">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <span class="eyebrow">Recent work</span>
          <h2 class="mt-4 text-display-lg">Real projects, real craftsmanship.</h2>
        </div>
        <Button href="/contact" variant="ghost">Start your project</Button>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3">
        {
          gallery.map((g, i) => (
            <div class:list={['overflow-hidden rounded-2xl', i === 0 ? 'col-span-2 lg:col-span-1' : '']}>
              <img
                src={g.src}
                alt={g.alt}
                class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-ink/50">
        Images are representative of our work and finish level. Ask for addresses of completed
        projects you can visit in person.
      </p>
    </div>
  </section>

  <Testimonials />

  <!-- About teaser -->
  <section class="section">
    <div class="container-rb grid items-center gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl">
        <img
          src="/images/michael-salamon-reliable-builders.jpg"
          alt="Michael Salamon, owner of Reliable Builders"
          class="w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <span class="eyebrow">Meet the builder</span>
        <h2 class="mt-4 text-display-md">You’ll work with Michael — not a call center.</h2>
        <p class="mt-5 text-lg text-ink/80">
          Reliable Builders is led by Michael Salamon, a San Diego contractor with 20 years in the
          trade. He’s in your home, on your project, and on the other end of the phone.
        </p>
        <p class="mt-4 text-ink/70">
          His whole approach comes down to one thing: treat every client like a friend, teach them
          what they need to know, and build something they’re proud to show off. That’s why so much
          of our work comes from referrals and neighbors.
        </p>
        <div class="mt-7">
          <Button href="/about" variant="ghost">Our story</Button>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={faqs} />

  <!-- Lead form -->
  <section class="section bg-stone-warm">
    <div class="container-rb grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div class="lg:pt-4">
        <span class="eyebrow">Free estimate</span>
        <h2 class="mt-4 text-display-md">Tell us what you’re thinking.</h2>
        <p class="mt-4 text-lg text-ink/75">
          Send a few details and we’ll follow up within one business day with honest next steps —
          whether that’s a site visit, a ballpark number, or just pointing you in the right
          direction.
        </p>
        <ul class="mt-8 space-y-3 text-ink/80">
          {['No pressure, ever', 'A real timeline and budget', 'Straight answers from day one'].map((t) => (
            <li class="flex items-center gap-3">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-navy-600 text-white">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 10l4 4 8-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              {t}
            </li>
          ))}
        </ul>
      </div>
      <LeadForm />
    </div>
  </section>

  <CTABand />
</BaseLayout>
