---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page Not Found | Reliable Builders" description="That page couldn’t be found." noindex={true}>
  <section class="section">
    <div class="container-rb flex min-h-[50vh] flex-col items-center justify-center text-center">
      <span class="font-display text-7xl font-bold text-brass-500">404</span>
      <h1 class="mt-4 text-display-md">We couldn’t find that page.</h1>
      <p class="mt-3 max-w-md text-ink/70">It may have moved. Let’s get you back on track.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/contact" variant="ghost">Contact us</Button>
      </div>
    </div>
  </section>
</BaseLayout>
