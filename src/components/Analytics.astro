---
// Analytics.astro — GA4 (+ optional Microsoft Clarity) loader and site-wide
// high-intent event tracking. Each loader renders only when its ID is set in
// src/config/analytics.ts, so the site works fine with analytics disabled.
import { GA4_ID, CLARITY_ID } from '../config/analytics';
---

{
  GA4_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    </>
  )
}

{
  CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", CLARITY_ID);
    </script>
  )
}

<script>
  // High-intent event tracking — the actions that signal a real lead.
  function track(name: string, params?: Record<string, unknown>) {
    const g = (window as any).gtag;
    if (typeof g === 'function') g('event', name, { page_path: location.pathname, ...params });
  }

  // Phone / text / email clicks (the highest-intent actions on a contractor site).
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      'a[href^="tel:"], a[href^="mailto:"], a[href^="sms:"]'
    );
    if (!a) return;
    const href = a.getAttribute('href') ?? '';
    const loc = a.closest('header') ? 'header' : a.closest('footer') ? 'footer' : 'body';
    if (href.startsWith('tel:')) track('phone_click', { call_location: loc, link_text: a.textContent?.trim() });
    else if (href.startsWith('mailto:')) track('email_click', { location: loc });
    else if (href.startsWith('sms:')) track('sms_click', { location: loc });
  });

  // "Get an estimate" / contact CTA clicks.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/contact"]');
    if (a) track('cta_contact_click', { cta_text: a.textContent?.trim() });
  });

  // Lead form submit attempt (the /thank-you page fires the completed-lead event).
  document.getElementById('lead-form')?.addEventListener('submit', () => track('lead_form_submit'));
</script>
