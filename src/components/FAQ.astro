---
export interface FaqItem {
  q: string;
  a: string;
}
export interface Props {
  items: FaqItem[];
  heading?: string;
}
const { items, heading = 'Common questions' } = Astro.props;

// FAQPage schema for rich results.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---

<section class="section">
  <div class="container-rb grid gap-10 lg:grid-cols-[0.9fr_1.4fr]">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2 class="mt-4 text-display-md">{heading}</h2>
      <p class="mt-4 text-ink/70">
        Straight answers, no runaround. Don’t see yours? Call or text us — we’re happy to talk it
        through before you commit to anything.
      </p>
    </div>
    <div class="divide-y divide-ink/10 border-t border-ink/10">
      {
        items.map((it) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
              <span class="text-lg font-semibold text-ink">{it.q}</span>
              <span
                class="mt-1 shrink-0 text-brass-500 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-prose-wide text-ink/75" set:html={it.a} />
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>
