---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import { site, services } from '../config/site';
---

<BaseLayout
  title="Remodeling Services in San Diego | Kitchens, Baths & ADUs — Reliable Builders"
  description="Reliable Builders offers kitchen remodels, bathroom remodels, and ADU construction across San Diego. Licensed, honest, and built to last. CSLB #1139785."
>
  <section class="bg-navy-800 py-20 text-white sm:py-24">
    <div class="container-rb max-w-3xl">
      <span class="eyebrow text-brass-300">Our services</span>
      <h1 class="mt-5 text-display-xl text-white">What we build in San Diego.</h1>
      <p class="mt-6 text-lg text-white/85">
        We focus on three things and do them exceptionally well — kitchens, bathrooms, and ADUs.
        We also take on whole-home remodels and new builds when it’s the right fit.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-rb space-y-8">
      {
        services.map((s, i) => (
          <div class:list={['grid items-center gap-8 lg:grid-cols-2', i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : '']}>
            <div class="overflow-hidden rounded-3xl">
              <img src={s.image} alt={s.name} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            </div>
            <div>
              <span class="rounded-full bg-brass-50 px-3 py-1 text-xs font-semibold text-brass-700">{s.priceRange}</span>
              <h2 class="mt-4 text-display-md">{s.name}</h2>
              <p class="mt-3 text-lg text-ink/75">{s.tagline}</p>
              <p class="mt-3 text-ink/70">{s.blurb}</p>
              <div class="mt-6">
                <Button href={`/services/${s.slug}`} variant="ghost">Learn more about {s.short.toLowerCase()}</Button>
              </div>
            </div>
          </div>
        ))
      }

    </div>
  </section>

  <!-- More services -->
  <section class="section bg-stone-warm">
    <div class="container-rb">
      <div class="max-w-2xl">
        <span class="eyebrow">More ways we can help</span>
        <h2 class="mt-4 text-display-md">Beyond kitchens & baths.</h2>
        <p class="mt-4 text-ink/70">
          With 20 years across whole-home renovations and ground-up builds, Michael takes on bigger
          projects too. Here’s what else we do.
        </p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          [
            { slug: 'garage-conversions', name: 'Garage Conversions', price: 'From $90K', blurb: 'Turn an underused garage into a legal ADU, JADU, or finished bonus room — faster and cheaper than building new.' },
            { slug: 'whole-home-remodels', name: 'Whole-Home Remodels', price: 'From $150K', blurb: 'A top-to-bottom renovation handled by one accountable crew, with the systems brought fully up to date.' },
            { slug: 'home-additions', name: 'Home Additions', price: 'From $100K', blurb: 'Add the square footage your home is missing — room additions and second stories, matched to the existing house.' },
          ].map((s) => (
            <a href={`/services/${s.slug}`} class="group card p-6 transition-shadow hover:shadow-lift">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold text-ink group-hover:text-navy-600">{s.name}</h3>
                <span class="rounded-full bg-brass-50 px-3 py-1 text-xs font-semibold text-brass-700">{s.price}</span>
              </div>
              <p class="mt-3 text-sm text-ink/70">{s.blurb}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-600 transition-all group-hover:gap-2.5">
                Learn more
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
