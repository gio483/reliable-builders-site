---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../config/site';

const principles = [
  { t: 'Educate first', d: 'We explain the how and the why so you can make confident decisions — not decisions made under pressure.' },
  { t: 'Tell the truth', d: 'If something isn’t worth the money, we’ll say so, even when the honest answer means a smaller job for us.' },
  { t: 'Respect the budget', d: 'Your number is the number. We help you get the most out of it instead of quietly steering you past it.' },
  { t: 'Build it to last', d: 'The right way costs a little more time and care. We spend it, because we want to be proud of it years from now.' },
];
---

<BaseLayout
  title="About Reliable Builders | San Diego Remodeling Contractor"
  description="Reliable Builders is led by Michael Salamon, a San Diego contractor with 20 years of experience. Honest, education-first remodeling. Licensed CSLB #1139785."
>
  <section class="bg-navy-800 py-20 text-white sm:py-24">
    <div class="container-rb max-w-3xl">
      <span class="eyebrow text-brass-300">Our story</span>
      <h1 class="mt-5 text-display-xl text-white">A builder you can actually trust.</h1>
      <p class="mt-6 text-lg text-white/85">
        Reliable Builders exists to be the contractor homeowners wish they’d found the first time —
        honest, communicative, and genuinely good at the work.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-rb grid items-center gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-3xl">
        <img
          src="/images/michael-salamon-reliable-builders.jpg"
          alt="Michael Salamon, owner of Reliable Builders"
          class="w-full object-cover"
        />
      </div>
      <div>
        <span class="eyebrow">Meet Michael</span>
        <h2 class="mt-4 text-display-md">20 years in the trade — and still hands-on.</h2>
        <p class="mt-5 text-lg text-ink/80">
          Michael Salamon has spent two decades building and remodeling homes across San Diego —
          whole-home renovations, new builds, ADUs, kitchens, and baths. He started Reliable
          Builders to do the work the way he always believed it should be done: with honesty,
          craftsmanship, and real relationships.
        </p>
        <p class="mt-4 text-ink/70">
          For Michael, this isn’t just a business — it’s how he provides for his family and builds
          something worth putting his name on. That’s why he treats every client like a friend and
          every project like it’s his own home. Do it right, tell the truth, and the referrals take
          care of the rest.
        </p>
        <p class="mt-4 text-ink/70">
          He still does the tile and stone work personally, still answers the phone, and still walks
          every project at the end to make sure it’s something you’re proud of.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="/contact" variant="primary">Work with us</Button>
          <Button href={`tel:${site.phoneRaw}`} variant="ghost">Call {site.phone}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-stone-warm">
    <div class="container-rb">
      <div class="max-w-2xl">
        <span class="eyebrow">What we stand for</span>
        <h2 class="mt-4 text-display-lg">Four rules we don’t break.</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p, i) => (
            <div class="card p-6">
              <span class="font-display text-4xl font-bold text-brass-300">{`0${i + 1}`}</span>
              <h3 class="mt-3 text-lg font-semibold text-ink">{p.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{p.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-rb grid gap-8 rounded-3xl bg-navy-600 p-8 text-white sm:grid-cols-3 sm:p-12">
      <div>
        <p class="font-display text-5xl font-bold text-brass-300">{site.yearsExperience}+</p>
        <p class="mt-2 text-white/80">Years of remodeling experience</p>
      </div>
      <div>
        <p class="font-display text-5xl font-bold text-brass-300">Licensed</p>
        <p class="mt-2 text-white/80">{site.license} · Fully insured</p>
      </div>
      <div>
        <p class="font-display text-5xl font-bold text-brass-300">San Diego</p>
        <p class="mt-2 text-white/80">Serving central & east county</p>
      </div>
    </div>
  </section>

  <CTABand heading="Let’s build something you’re proud of." />
</BaseLayout>
