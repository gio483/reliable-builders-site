<ServiceLayout
  slug="home-additions"
  metaTitle="Home Additions San Diego | Room & Second-Story Additions — Reliable Builders"
  metaDescription="Licensed San Diego home additions — room additions and second-story additions that match your home and pass inspection. One accountable crew. CSLB #1139785."
  eyebrow="Home Additions · San Diego"
  headline="Add the space your home is missing."
  subhead="Room additions and second-story additions that add real square footage — matched to your existing home and built by one accountable crew that handles the permits and the structure."
  heroImage="/images/work-kitchen-2.jpg"
  priceRange="From $100K"
  includes={includes}
