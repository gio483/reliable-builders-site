---
// Reliable Builders official logo (roofline + "RELIABLE BUILDERS INC" wordmark).
// `variant` picks the navy version (for light backgrounds, default) or the white
// version (for dark backgrounds like the footer / navy hero).
export interface Props {
  class?: string;
  variant?: 'default' | 'light';
}
const { class: className = 'h-10 w-auto', variant = 'default' } = Astro.props;
const src =
  variant === 'light'
    ? '/images/reliable-builders-logo-white.png'
    : '/images/reliable-builders-logo-navy.png';
---

<img src={src} alt="Reliable Builders Inc — San Diego remodeling & ADU contractor" class={className} />
