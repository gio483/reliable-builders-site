---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import { site, services } from '../config/site';
---

<BaseLayout
  title="Remodeling Services in San Diego | Kitchens, Baths & ADUs — Reliable Builders"
  description="Reliable Builders offers kitchen remodels, bathroom remodels, and ADU construction across San Diego. Licensed, honest, and built to last. CSLB #1139785."
>
  <section class="bg-navy-800 py-20 text-white sm:py-24">
    <div class="container-rb max-w-3xl">
      <span class="eyebrow text-brass-300">Our services</span>
      <h1 class="mt-5 text-display-xl text-white">What we build in San Diego.</h1>
      <p class="mt-6 text-lg text-white/85">
        We focus on three things and do them exceptionally well — kitchens, bathrooms, and ADUs.
        We also take on whole-home remodels and new builds when it’s the right fit.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-rb space-y-8">
      {
        services.map((s, i) => (
          <div class:list={['grid items-center gap-8 lg:grid-cols-2', i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : '']}>
            <div class="overflow-hidden rounded-3xl">
              <img src={s.image} alt={s.name} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            </div>
            <div>
              <span class="rounded-full bg-brass-50 px-3 py-1 text-xs font-semibold text-brass-700">{s.priceRange}</span>
              <h2 class="mt-4 text-display-md">{s.name}</h2>
              <p class="mt-3 text-lg text-ink/75">{s.tagline}</p>
              <p class="mt-3 text-ink/70">{s.blurb}</p>
              <div class="mt-6">
                <Button href={`/services/${s.slug}`} variant="ghost">Learn more about {s.short.toLowerCase()}</Button>
              </div>
            </div>
          </div>
        ))
      }

      <div class="card mt-4 p-8 text-center">
        <h2 class="text-display-sm">Whole-home remodels & new builds</h2>
        <p class="mx-auto mt-3 max-w-2xl text-ink/70">
          With 20 years across whole-home renovations and ground-up builds, Michael can take on
          bigger projects too. If you’re planning something major, let’s talk through it.
        </p>
        <div class="mt-6 flex justify-center">
          <Button href={`tel:${site.phoneRaw}`} variant="primary">Call {site.phone}</Button>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
