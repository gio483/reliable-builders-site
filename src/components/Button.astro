---
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'white';
  size?: 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brass-400 focus-visible:ring-offset-2';
const sizes = {
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};
const variants = {
  primary: 'bg-navy-600 text-white hover:bg-navy-700 shadow-card',
  secondary: 'bg-brass-500 text-white hover:bg-brass-600 shadow-card',
  ghost: 'bg-transparent text-navy-700 ring-1 ring-navy-200 hover:bg-white',
  white: 'bg-white text-navy-700 hover:bg-stone-warm shadow-card',
};
---

<a href={href} class:list={[base, sizes[size], variants[variant], className]} target={target} rel={rel}>
  <slot />
</a>
